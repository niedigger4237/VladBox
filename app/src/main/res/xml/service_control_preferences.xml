<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <PreferenceCategory app:title="@string/service_control">
        <SwitchPreference app:defaultValue="false" app:key="scEnabled" app:title="@string/sc_enable" app:summary="@string/sc_enable_sum" />
    </PreferenceCategory>
    <PreferenceCategory app:title="@string/sc_schedule">
        <SwitchPreference app:defaultValue="false" app:key="scSchedule" app:title="@string/sc_schedule_enable" />
        <EditTextPreference app:key="scStartCron" app:title="@string/sc_start_cron" app:summary="@string/sc_cron_sum" />
        <EditTextPreference app:key="scStopCron" app:title="@string/sc_stop_cron" app:summary="@string/sc_cron_sum" />
    </PreferenceCategory>
    <PreferenceCategory app:title="Wi-Fi">
        <SwitchPreference app:defaultValue="false" app:key="scWifi" app:title="@string/sc_wifi_enable" app:summary="@string/sc_wifi_sum" />
        <SwitchPreference app:defaultValue="false" app:key="scWifi_connectStart" app:title="@string/sc_wifi_connect_start" />
        <EditTextPreference app:key="scWifi_connectStart_ssids" app:title="SSID" app:dialogMessage="@string/sc_ids_hint" app:useSimpleSummaryProvider="true" />
        <EditTextPreference app:key="scWifi_connectStart_bssids" app:title="BSSID" app:dialogMessage="@string/sc_ids_hint" app:useSimpleSummaryProvider="true" />
        <SwitchPreference app:defaultValue="false" app:key="scWifi_connectStop" app:title="@string/sc_wifi_connect_stop" />
        <EditTextPreference app:key="scWifi_connectStop_ssids" app:title="SSID" app:dialogMessage="@string/sc_ids_hint" app:useSimpleSummaryProvider="true" />
        <EditTextPreference app:key="scWifi_connectStop_bssids" app:title="BSSID" app:dialogMessage="@string/sc_ids_hint" app:useSimpleSummaryProvider="true" />
        <SwitchPreference app:defaultValue="false" app:key="scWifi_disconnectStart" app:title="@string/sc_wifi_disconnect_start" />
        <EditTextPreference app:key="scWifi_disconnectStart_ssids" app:title="SSID" app:dialogMessage="@string/sc_ids_hint" app:useSimpleSummaryProvider="true" />
        <EditTextPreference app:key="scWifi_disconnectStart_bssids" app:title="BSSID" app:dialogMessage="@string/sc_ids_hint" app:useSimpleSummaryProvider="true" />
        <SwitchPreference app:defaultValue="false" app:key="scWifi_disconnectStop" app:title="@string/sc_wifi_disconnect_stop" />
        <EditTextPreference app:key="scWifi_disconnectStop_ssids" app:title="SSID" app:dialogMessage="@string/sc_ids_hint" app:useSimpleSummaryProvider="true" />
        <EditTextPreference app:key="scWifi_disconnectStop_bssids" app:title="BSSID" app:dialogMessage="@string/sc_ids_hint" app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>
    <PreferenceCategory app:key="scKeyguardCat" app:title="@string/sc_keyguard">
        <SwitchPreference app:defaultValue="false" app:key="scKeyguard" app:title="@string/sc_keyguard_enable" app:summary="@string/sc_keyguard_sum" />
        <SwitchPreference app:defaultValue="false" app:key="scLockStart" app:title="@string/sc_lock_start" />
        <SwitchPreference app:defaultValue="false" app:key="scLockStop" app:title="@string/sc_lock_stop" />
        <SwitchPreference app:defaultValue="false" app:key="scUnlockStart" app:title="@string/sc_unlock_start" />
        <SwitchPreference app:defaultValue="false" app:key="scUnlockStop" app:title="@string/sc_unlock_stop" />
    </PreferenceCategory>
</PreferenceScreen>
