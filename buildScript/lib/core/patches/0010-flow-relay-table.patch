diff --git a/common/androidcli/flowmeta/relay.go b/common/androidcli/flowmeta/relay.go
new file mode 100644
--- /dev/null
+++ b/common/androidcli/flowmeta/relay.go
@@ -0,0 +1,99 @@
+// Copyright 2026, Asterisk4Magisk contributors
+// SPDX-License-Identifier: LGPL-3.0
+
+package flowmeta
+
+import (
+	"container/list"
+	"encoding/binary"
+	"net/netip"
+	"sync"
+	"time"
+)
+
+// RelaySession binds one local UDP relay generation to an original socket.
+// Key is an internal cache ID, not a routable or exposed client address.
+type RelaySession struct {
+	Key, Relay, Original netip.AddrPort
+	UID uint32
+}
+
+type relayEntry struct {
+	session *RelaySession
+	last time.Time
+}
+
+// RelayTable bounds the number of associations and assigns non-reused keys
+// even if a local UDP port is recycled. Full-cone traffic may vary destination.
+type RelayTable struct {
+	mu sync.Mutex
+	capacity int
+	idle time.Duration
+	next uint64
+	entries map[netip.AddrPort]*list.Element
+	lru list.List
+}
+
+func NewRelayTable(capacity int, idle time.Duration) *RelayTable {
+	if capacity <= 0 || idle <= 0 {
+		panic("invalid relay table limits")
+	}
+	return &RelayTable{capacity: capacity, idle: idle, entries: make(map[netip.AddrPort]*list.Element)}
+}
+
+func (t *RelayTable) remove(element *list.Element) {
+	delete(t.entries, element.Value.(*relayEntry).session.Relay)
+	t.lru.Remove(element)
+}
+
+func (t *RelayTable) Get(relay, original netip.AddrPort, uid uint32, now time.Time) *RelaySession {
+	if !relay.IsValid() || !relay.Addr().IsLoopback() || relay.Port() == 0 || !original.IsValid() || original.Port() == 0 {
+		return nil
+	}
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	if element := t.entries[relay]; element != nil {
+		entry := element.Value.(*relayEntry)
+		if now.Sub(entry.last) < t.idle && entry.session.Original == original && entry.session.UID == uid {
+			entry.last = now
+			t.lru.MoveToFront(element)
+			return entry.session
+		}
+		t.remove(element)
+	}
+	for element := t.lru.Back(); element != nil; element = t.lru.Back() {
+		if len(t.entries) < t.capacity && now.Sub(element.Value.(*relayEntry).last) < t.idle {
+			break
+		}
+		t.remove(element)
+	}
+	t.next++
+	var key [16]byte
+	key[0] = 0xfd
+	binary.BigEndian.PutUint64(key[8:], t.next)
+	session := &RelaySession{Key: netip.AddrPortFrom(netip.AddrFrom16(key), 1), Relay: relay, Original: original, UID: uid}
+	t.entries[relay] = t.lru.PushFront(&relayEntry{session: session, last: now})
+	return session
+}
+
+func (t *RelayTable) Valid(session *RelaySession, now time.Time) bool {
+	if session == nil {
+		return false
+	}
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	element := t.entries[session.Relay]
+	if element == nil {
+		return false
+	}
+	entry := element.Value.(*relayEntry)
+	return entry.session == session && now.Sub(entry.last) < t.idle
+}
+
+func (t *RelayTable) Clear() {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	clear(t.entries)
+	t.lru.Init()
+	// Do not reset the generation counter: in-flight NAT entries may still close.
+}

diff --git a/common/androidcli/flowmeta/relay_test.go b/common/androidcli/flowmeta/relay_test.go
new file mode 100644
--- /dev/null
+++ b/common/androidcli/flowmeta/relay_test.go
@@ -0,0 +1,67 @@
+package flowmeta
+
+import (
+	"net/netip"
+	"sync"
+	"testing"
+	"time"
+)
+
+func TestRelayRebind(t *testing.T) {
+	now := time.Now()
+	table := NewRelayTable(4, time.Minute)
+	src := netip.MustParseAddrPort("10.0.0.2:5000")
+	a := netip.MustParseAddrPort("127.0.0.1:30001")
+	b := netip.MustParseAddrPort("127.0.0.1:30002")
+	first := table.Get(a, src, 10001, now)
+	if table.Get(a, src, 10001, now) != first {
+		t.Fatal("stable relay must reuse association")
+	}
+	second := table.Get(b, src, 10001, now)
+	if second.Key == first.Key {
+		t.Fatal("different relay inherited previous NAT key")
+	}
+	reused := table.Get(a, src, 10002, now)
+	if reused.Key == first.Key || table.Valid(first, now) || !table.Valid(reused, now) {
+		t.Fatal("recycled relay inherited old UID")
+	}
+	table.Clear()
+	if table.Valid(reused, now) || table.Get(a, src, 10002, now).Key == reused.Key {
+		t.Fatal("reset reused previous generation")
+	}
+}
+
+func TestRelayCapacityAndExpiration(t *testing.T) {
+	now := time.Now()
+	table := NewRelayTable(32, time.Minute)
+	src := netip.MustParseAddrPort("[fd00::2]:5000")
+	var first *RelaySession
+	for n := 1; n <= 20000; n++ {
+		session := table.Get(netip.AddrPortFrom(netip.MustParseAddr("127.0.0.1"), uint16(n)), src, 10001, now)
+		if n == 1 { first = session }
+		if len(table.entries) > 32 { t.Fatal("capacity exceeded") }
+	}
+	if table.Valid(first, now) { t.Fatal("evicted generation still valid") }
+	last := table.Get(netip.MustParseAddrPort("127.0.0.1:20000"), src, 10001, now)
+	if table.Valid(last, now.Add(time.Minute)) { t.Fatal("expired generation still valid") }
+	if table.Get(last.Relay, src, 10001, now.Add(time.Minute)).Key == last.Key { t.Fatal("expired key reused") }
+}
+
+func TestRelayConcurrent(t *testing.T) {
+	table := NewRelayTable(64, time.Minute)
+	var wg sync.WaitGroup
+	for n := 1; n <= 8; n++ {
+		wg.Add(1)
+		go func(n int) {
+			defer wg.Done()
+			for k := 0; k < 1000; k++ {
+				addr := netip.AddrPortFrom(netip.MustParseAddr("127.0.0.1"), uint16(n*1000+k))
+				now := time.Now()
+				session := table.Get(addr, addr, 10001, now)
+				table.Valid(session, now)
+			}
+		}(n)
+	}
+	wg.Wait()
+	if len(table.entries) > 64 { t.Fatal("capacity exceeded") }
+}
