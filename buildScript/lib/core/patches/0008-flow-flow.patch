+
+package socks
+
+import (
+	"context"
+	"net"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/adapter/inbound"
+	"github.com/sagernet/sing-box/common/androidcli/flowmeta"
+	"github.com/sagernet/sing-box/common/listener"
+	"github.com/sagernet/sing-box/log"
+	"github.com/sagernet/sing-box/option"
+	"github.com/sagernet/sing/common/buf"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+	"github.com/sagernet/sing/common/udpnat2"
+)
+
+type flowInbound struct {
+	inbound.Adapter
+	ctx      context.Context
+	router   adapter.Router
+	logger   log.ContextLogger
+	listener *listener.Listener
+	nat      *udpnat.Service
+	udpMu sync.Mutex
+	relays *flowmeta.RelayTable
+	closing bool
+	token    string
+	tcpAccepted atomic.Bool
+	tcpRejected atomic.Bool
+	udpAccepted atomic.Bool
+	udpRejected atomic.Bool
+}
+
+type flowPacketInfo struct {
+	header flowmeta.Header
+	relay  M.Socksaddr
+	session *flowmeta.RelaySession
+}
+
+func newFlowInbound(ctx context.Context, router adapter.Router, logger log.ContextLogger, tag string, options option.SocksInboundOptions, token string) (adapter.Inbound, error) {
+	if len(token) != 32 {
+		return nil, flowmeta.ErrHeader
+	}
+	i := &flowInbound{
+		Adapter: inbound.NewAdapter("socks", tag),
+		ctx:     ctx,
+		router:  router,
+		logger:  logger,
+		token:   token,
+	}
+	i.nat = udpnat.New(i, i.prepare, time.Minute, false)
+	i.relays = flowmeta.NewRelayTable(1024, time.Minute)
+	i.listener = listener.New(listener.Options{
+		Context:           ctx,
+		Logger:            logger,
+		Network:           []string{"tcp", "udp"},
+		Listen:            options.ListenOptions,
+		ConnectionHandler: i,
+		PacketHandler:     i,
+	})
+	return i, nil
+}
+
+func (i *flowInbound) Start(stage adapter.StartStage, scope *adapter.Scope) error {
+	if stage != adapter.StartStateStart {
+		return nil
+	}
+	if err := i.listener.Start(); err != nil {
+		return err
+	}
+	scope.Add(i.listener.Close)
+	stopSweep := make(chan struct{})
+	sweepDone := make(chan struct{})
+	go i.sweepIdleUDP(stopSweep, sweepDone)
+	scope.Add(func() error {
+		close(stopSweep)
+		<-sweepDone
+		i.udpMu.Lock()
+		defer i.udpMu.Unlock()
+		i.closing = true
+		i.relays.Clear()
+		i.nat.Purge()
+		return nil
+	})
+	return nil
+}
+
+// The pinned UDP NAT cache otherwise purges on traffic/cache operations.
+// A single lifecycle-bound sweep releases idle connections during silence,
+// without forcing GC or shortening live session timeouts.
+func (i *flowInbound) sweepIdleUDP(stop <-chan struct{}, done chan<- struct{}) {
+	defer close(done)
+	ticker := time.NewTicker(30 * time.Second)
+	defer ticker.Stop()
+	for {
+		select {
+		case <-stop:
+			return
+		case <-i.ctx.Done():
+			return
+		case <-ticker.C:
+			i.udpMu.Lock()
+			if !i.closing {
+				i.relays.PurgeExpired(time.Now())
+				i.nat.PurgeExpired()
+			}
+			i.udpMu.Unlock()
+		}
+	}
+}
+
+func (i *flowInbound) InterfaceUpdated(context.Context) {
+	i.udpMu.Lock()
+	defer i.udpMu.Unlock()
+	i.relays.Clear()
+	i.nat.Purge()
+}
+
+func (i *flowInbound) metadata(h flowmeta.Header) adapter.InboundContext {
+	m := adapter.InboundContext{
+		Inbound:           i.Tag(),
+		InboundType:       i.Type(),
+		Source:            M.SocksaddrFromNet(h.Addr(true)),
+		Destination:       M.SocksaddrFromNet(h.Addr(false)),
+		OriginDestination: M.SocksaddrFromNet(h.Addr(false)),
+	}
+	if h.UID != flowmeta.UnknownUID {
+		m.ProcessInfo = &adapter.ConnectionOwner{UserId: int32(h.UID)}
+	}
+	return m
+}
+
+func (i *flowInbound) NewConnection(ctx context.Context, conn net.Conn, _ adapter.InboundContext, onClose N.CloseHandlerFunc) {
+	_ = conn.SetReadDeadline(time.Now().Add(10 * time.Second))
+	h, err := flowmeta.Read(conn, i.token)
+	if err != nil {
+		if i.tcpRejected.CompareAndSwap(false, true) {
+			i.logger.Warn("flow metadata TCP header rejected: ", err)
+		} else {
+			i.logger.DebugContext(ctx, "flow metadata TCP header rejected: ", err)
+		}
+		N.CloseOnHandshakeFailure(conn, onClose, err)
+		return
+	}
+	if i.tcpAccepted.CompareAndSwap(false, true) {
+		i.logger.Info("flow metadata TCP header authenticated")
+	}
+	i.logger.DebugContext(ctx, "flow metadata TCP destination: ", h.Destination)
+	_ = conn.SetReadDeadline(time.Time{})
+	if h.UID == 0 || h.UID == flowmeta.UnknownUID {
+		ctx = flowmeta.ContextWithHeader(ctx, h)
+	}
+	i.router.RouteConnectionEx(ctx, conn, i.metadata(h), onClose)
+}
+
+func (i *flowInbound) NewPacket(buffer *buf.Buffer, source M.Socksaddr) {
+	h, n, err := flowmeta.Parse(buffer.Bytes(), i.token, true)
+	if err != nil {
+		if i.udpRejected.CompareAndSwap(false, true) {
+			i.logger.Warn("flow metadata UDP header rejected: ", err)
+		}
+		return
+	}
+	if i.udpAccepted.CompareAndSwap(false, true) {
+		i.logger.Info("flow metadata UDP header authenticated")
+	}
+	i.udpMu.Lock()
+	defer i.udpMu.Unlock()
+	if i.closing {
+		return
+	}
+	// Each HEV/BPF UDP socket owns its own relay. Never route a new relay
+	// through an earlier association for the same original client tuple.
+	session := i.relays.Get(source.AddrPort(), h.Source, h.UID, time.Now())
+	if session == nil {
+		return
+	}
+	i.nat.NewPacket([][]byte{buffer.Bytes()[n:]}, M.SocksaddrFromNetIP(session.Key), M.SocksaddrFromNet(h.Addr(false)), flowPacketInfo{h, source, session})
+}
+
+func (i *flowInbound) NewPacketBatch(buffers []*buf.Buffer, sources []M.Socksaddr) {
+	if len(buffers) != len(sources) {
+		buf.ReleaseMulti(buffers)
+		return
+	}
+	for n, b := range buffers {
+		i.NewPacket(b, sources[n])
+		b.Release()
+	}
+}
+
+func (i *flowInbound) prepare(source, destination M.Socksaddr, data any) (bool, context.Context, N.PacketWriter, N.CloseHandlerFunc) {
+	info := data.(flowPacketInfo)
+	return true, flowmeta.ContextWithHeader(log.ContextWithNewID(i.ctx), info.header), &flowPacketWriter{i, info}, nil
+}
+
+func (i *flowInbound) NewPacketConnectionEx(ctx context.Context, conn N.PacketConn, source, destination M.Socksaddr, onClose N.CloseHandlerFunc) {
+	h, _ := flowmeta.HeaderFromContext(ctx)
+	// The generated address is only a private NAT cache key; expose the real
+	// original client address to routing and outbound handlers.
+	if native, ok := conn.(udpnat.Conn); ok {
+		conn = &flowLocalConn{Conn: native, local: h.Addr(true)}
+	}
+	i.router.RoutePacketConnectionEx(ctx, conn, i.metadata(h), onClose)
+}
+
+type flowLocalConn struct {
+	udpnat.Conn
+	local net.Addr
+}
+
+func (c *flowLocalConn) LocalAddr() net.Addr { return c.local }
+func (c *flowLocalConn) Upstream() any { return c.Conn }
+func (c *flowLocalConn) CreatePacketBatchReadWaiter() (N.PacketBatchReadWaiter, bool) {
+	if creator, ok := c.Conn.(N.PacketBatchReadWaitCreator); ok {
+		return creator.CreatePacketBatchReadWaiter()
+	}
+	return nil, false
+}
+func (c *flowLocalConn) CreatePacketBatchWriter() (N.PacketBatchWriter, bool) {
+	if creator, ok := c.Conn.(N.PacketBatchWriteCreator); ok {
+		return creator.CreatePacketBatchWriter()
+	}
+	return nil, false
+}
+
+type flowPacketWriter struct {
+	i    *flowInbound
+	info flowPacketInfo
+}
+
+func (w *flowPacketWriter) WritePacket(buffer *buf.Buffer, source M.Socksaddr) error {
+	defer buffer.Release()
+	if !w.i.relays.Valid(w.info.session, time.Now()) {
+		return net.ErrClosed
+	}
+	output := buf.NewSize(flowmeta.MaxHeader + buffer.Len())
+	n, err := w.info.header.Reverse(source.AddrPort()).MarshalTo(output.Extend(flowmeta.MaxHeader), w.i.token)
+	if err != nil {
+		output.Release()
+		w.i.logger.Debug("flow metadata UDP response encode failed: ", err)
+		return err
+	}
+	output.Truncate(n)
+	_, _ = output.Write(buffer.Bytes())
+	return w.i.listener.PacketWriter().WritePacket(output, w.info.relay)
+}
