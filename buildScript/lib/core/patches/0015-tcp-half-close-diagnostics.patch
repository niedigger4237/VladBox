diff --git a/route/niefigger_tcp_close.go b/route/niefigger_tcp_close.go
new file mode 100644
--- /dev/null
+++ b/route/niefigger_tcp_close.go
@@ -0,0 +1,15 @@
+package route
+
+import (
+	"errors"
+	"net"
+)
+
+// gVisor reports ErrNotConnected as a plain error inside net.OpError
+// when a TCP endpoint no longer accepts Shutdown. Only use this helper
+// for CloseWrite errors after a successful copy, not I/O errors.
+func isDisconnectedTCPHalfClose(err error) bool {
+	var opErr *net.OpError
+	return errors.As(err, &opErr) && opErr.Op == "close" && opErr.Net == "tcp" &&
+		opErr.Err != nil && opErr.Err.Error() == "endpoint not connected"
+}
diff --git a/route/niefigger_tcp_close_test.go b/route/niefigger_tcp_close_test.go
new file mode 100644
--- /dev/null
+++ b/route/niefigger_tcp_close_test.go
@@ -0,0 +1,31 @@
+package route
+
+import (
+	"errors"
+	"fmt"
+	"net"
+	"testing"
+)
+
+func TestDisconnectedTCPHalfClose(t *testing.T) {
+	for _, tt := range []struct {
+		name string
+		err error
+		want bool
+	}{
+		{"nil", nil, false},
+		{"half-close", &net.OpError{Op: "close", Net: "tcp", Err: errors.New("endpoint not connected")}, true},
+		{"wrapped", fmt.Errorf("close: %w", &net.OpError{Op: "close", Net: "tcp", Err: errors.New("endpoint not connected")}), true},
+		{"read", &net.OpError{Op: "read", Net: "tcp", Err: errors.New("endpoint not connected")}, false},
+		{"write", &net.OpError{Op: "write", Net: "tcp", Err: errors.New("endpoint not connected")}, false},
+		{"udp", &net.OpError{Op: "close", Net: "udp", Err: errors.New("endpoint not connected")}, false},
+		{"reset", &net.OpError{Op: "close", Net: "tcp", Err: errors.New("connection reset by peer")}, false},
+		{"untyped", errors.New("endpoint not connected"), false},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			if got := isDisconnectedTCPHalfClose(tt.err); got != tt.want {
+				t.Fatalf("got %v, want %v", got, tt.want)
+			}
+		})
+	}
+}
