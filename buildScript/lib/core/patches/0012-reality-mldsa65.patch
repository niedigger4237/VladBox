diff --git a/common/tls/reality_mldsa65.go b/common/tls/reality_mldsa65.go
new file mode 100644
--- /dev/null
+++ b/common/tls/reality_mldsa65.go
@@ -0,0 +1,23 @@
+//go:build with_utls
+
+package tls
+
+import (
+	"crypto/hmac"
+	"crypto/sha512"
+
+	"github.com/cloudflare/circl/sign/mldsa/mldsa65"
+)
+
+// Verify the Xray REALITY transcript with the configured ML-DSA-65 public key.
+// This is an additional check, never a replacement for the REALITY HMAC.
+func verifyRealityMldsa65(key *mldsa65.PublicKey, authKey, ed25519Key, clientHello, serverHello, signature []byte) bool {
+	if key == nil || len(authKey) == 0 || len(ed25519Key) != 32 || len(clientHello) == 0 || len(serverHello) == 0 || len(signature) != mldsa65.SignatureSize {
+		return false
+	}
+	h := hmac.New(sha512.New, authKey)
+	h.Write(ed25519Key)
+	h.Write(clientHello)
+	h.Write(serverHello)
+	return mldsa65.Verify(key, h.Sum(nil), nil, signature)
+}
