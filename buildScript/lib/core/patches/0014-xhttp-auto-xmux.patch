-func decideHTTPVersion(tlsConfig tls.Config) string {
+// Auto follows Xray: REALITY uses stream-one, or stream-up when split.
+func resolveClientMode(mode string, reality, download bool) string {
+	if mode != "" && mode != "auto" {
+		return mode
+	}
+	if !reality {
+		return "packet-up"
+	}
+	if download {
+		return "stream-up"
+	}
+	return "stream-one"
+}
+
+func isRealityTLS(config tls.Config) bool {
+	for config != nil {
+		if wrapper, ok := config.(*tls.KTLSClientConfig); ok {
+			config = wrapper.Config
+			continue
+		}
+		marker, ok := config.(interface{ IsRealityClient() bool })
+		return ok && marker.IsRealityClient()
+	}
+	return false
+}
+
+func decideHTTPVersion(tlsConfig tls.Config) string {
 	if tlsConfig == nil || len(tlsConfig.NextProtos()) == 0 || tlsConfig.NextProtos()[0] == "http/1.1" {
 		return "1.1"
 	}
