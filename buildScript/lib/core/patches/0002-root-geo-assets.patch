+package main
+
+import (
+	"fmt"
+	"net"
+	"os"
+	"path/filepath"
+	"strings"
+
+	"github.com/oschwald/maxminddb-golang"
+	geosites "github.com/sagernet/sing-box/common/geosite"
+	C "github.com/sagernet/sing-box/constant"
+	"github.com/sagernet/sing-box/nekoutils"
+	"github.com/sagernet/sing-box/option"
+)
+
+// The in-app core (libcore) provides geoip:/geosite: local rule-sets from geoip.db / geosite.db.
+// The standalone root-mode binary needs the same hooks; NEKO_ASSETS_DIR points at the app's assets.
+func init() {
+	dir := os.Getenv("NEKO_ASSETS_DIR")
+
+	nekoutils.GetGeoIPHeadlessRules = func(name string) ([]option.HeadlessRule, error) {
+		if dir == "" {
+			return nil, fmt.Errorf("geoip: NEKO_ASSETS_DIR is not set")
+		}
+		reader, err := maxminddb.Open(filepath.Join(dir, "geoip.db"))
+		if err != nil {
+			return nil, err
+		}
+		defer reader.Close()
+		networks := reader.Networks(maxminddb.SkipAliasedNetworks)
+		code := strings.ToLower(name)
+		var cidrs []string
+		var ipNet *net.IPNet
+		var country string
+		for networks.Next() {
+			ipNet, err = networks.Network(&country)
+			if err != nil {
+				return nil, fmt.Errorf("failed to get network: %w", err)
+			}
+			if country == code {
+				cidrs = append(cidrs, ipNet.String())
+			}
+		}
+		if len(cidrs) == 0 {
+			return nil, fmt.Errorf("no networks found for country code: %s", name)
+		}
+		return []option.HeadlessRule{{
+			Type:           C.RuleTypeDefault,
+			DefaultOptions: option.DefaultHeadlessRule{IPCIDR: cidrs},
+		}}, nil
+	}
+
+	nekoutils.GetGeoSiteHeadlessRules = func(name string) ([]option.HeadlessRule, error) {
+		if dir == "" {
+			return nil, fmt.Errorf("geosite: NEKO_ASSETS_DIR is not set")
+		}
+		reader, _, err := geosites.Open(filepath.Join(dir, "geosite.db"))
+		if err != nil {
+			return nil, err
+		}
+		items, err := reader.Read(name)
+		if err != nil {
+			return nil, fmt.Errorf("failed to read geosite code %s: %w", name, err)
+		}
+		compiled := geosites.Compile(items)
+		return []option.HeadlessRule{{
+			Type: C.RuleTypeDefault,
+			DefaultOptions: option.DefaultHeadlessRule{
+				Domain:        compiled.Domain,
+				DomainSuffix:  compiled.DomainSuffix,
+				DomainKeyword: compiled.DomainKeyword,
+				DomainRegex:   compiled.DomainRegex,
+			},
+		}}, nil
+	}
+}
